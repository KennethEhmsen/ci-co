{
  "name": "@cicd/shared",
  "version": "1.0.0",
  "description": "Shared utilities for CI/CD platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  }
}
