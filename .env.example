# =============================================================================
# LOCAL CI/CD PLATFORM - Environment Variables
# =============================================================================
# Copy this file to .env and update the values for your environment
#
# For local development, you can use the default values below.
# For production, generate secure passwords using:
#   openssl rand -hex 32  (for secret keys)
#   openssl rand -base64 24  (for passwords)
# =============================================================================

# -----------------------------------------------------------------------------
# Gitea (Git Server) Database
# -----------------------------------------------------------------------------
POSTGRES_USER=gitea
POSTGRES_PASSWORD=gitea_secure_password_change_me
POSTGRES_DB=gitea

# -----------------------------------------------------------------------------
# Gitea Admin User (created automatically on first startup)
# -----------------------------------------------------------------------------
GITEA_ADMIN_USER=localadmin
GITEA_ADMIN_PASSWORD=admin123
GITEA_ADMIN_EMAIL=admin@localhost.local

# -----------------------------------------------------------------------------
# Gitea Security Keys
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
GITEA_SECRET_KEY=change_this_to_a_64_char_hex_string_for_production_use
GITEA_INTERNAL_TOKEN=change_this_to_another_64_char_hex_string_for_production

# -----------------------------------------------------------------------------
# Gitea Domain (optional - defaults to localhost)
# -----------------------------------------------------------------------------
# GITEA_DOMAIN=localhost

# -----------------------------------------------------------------------------
# Drone CI Configuration
# Generate with: openssl rand -hex 16
# -----------------------------------------------------------------------------
DRONE_RPC_SECRET=change_this_drone_rpc_secret_for_production

# Drone API token (get from Drone UI after first login)
# DRONE_TOKEN=

# -----------------------------------------------------------------------------
# SonarQube Database
# -----------------------------------------------------------------------------
SONARQUBE_DB_USER=sonar
SONARQUBE_DB_PASSWORD=sonar_secure_password_change_me
SONARQUBE_DB_NAME=sonarqube

# -----------------------------------------------------------------------------
# Dependency-Track Database
# -----------------------------------------------------------------------------
DTRACK_DB_USER=dtrack
DTRACK_DB_PASSWORD=dtrack_secure_password_change_me
DTRACK_DB_NAME=dtrack

# Dependency-Track API Key (get from Dependency-Track UI after first login)
# DTRACK_API_KEY=

# -----------------------------------------------------------------------------
# Service URLs (defaults work for local Docker setup)
# -----------------------------------------------------------------------------
# GITEA_URL=http://localhost:3000
# DRONE_URL=http://localhost:8085
# SONARQUBE_URL=http://localhost:9000
# DTRACK_URL=http://localhost:8081
# TRIVY_URL=http://localhost:4954
# REGISTRY_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Anthropic API Key (required for cicd-agent CLI)
# Get from: https://console.anthropic.com/
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
