{
  "name": "ci-co",
  "version": "1.20.0",
  "private": true,
  "description": "Local CI/CD Platform with Security Scanning",
  "workspaces": [
    "shared",
    "mcp-server",
    "cicd-agent"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w mcp-server && npm run build -w cicd-agent",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "lint": "eslint shared/src mcp-server/src cicd-agent/src",
    "lint:fix": "eslint shared/src mcp-server/src cicd-agent/src --fix",
    "format": "prettier --write \"**/src/**/*.ts\"",
    "format:check": "prettier --check \"**/src/**/*.ts\"",
    "clean": "rimraf shared/dist mcp-server/dist cicd-agent/dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.0",
    "rimraf": "^6.1.2",
    "semantic-release": "^25.0.2",
    "typescript-eslint": "^8.50.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KennethEhmsen/ci-co.git"
  },
  "author": "Kenneth Ehmsen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KennethEhmsen/ci-co/issues"
  },
  "homepage": "https://github.com/KennethEhmsen/ci-co#readme"
}
