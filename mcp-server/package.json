{
  "name": "cicd-security-mcp-server",
  "version": "1.16.1",
  "description": "MCP Server for CI/CD Security Tools - Trivy, SonarQube, Dependency-Track, Gitea, Drone CI",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "claude",
    "security",
    "trivy",
    "sonarqube",
    "dependency-track",
    "gitea",
    "drone"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cicd/shared": "file:../shared",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.16",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
