{
  "name": "cicd-security-agent",
  "version": "1.13.1",
  "description": "Claude Code Agent for CI/CD Security - integrates Trivy, SonarQube, Dependency-Track, Gitea, and Drone CI",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "cicd-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security-scan": "node dist/index.js security-scan",
    "full-report": "node dist/index.js full-report"
  },
  "keywords": [
    "claude",
    "agent",
    "security",
    "cicd",
    "trivy",
    "sonarqube"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@cicd/shared": "file:../shared",
    "chalk": "^5.3.0",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.16",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
